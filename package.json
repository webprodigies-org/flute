{
  "name": "@flute/scene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:library",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run tests/core",
    "test:react": "vitest run tests/react",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:browser": "playwright test",
    "verify:surface": "npm run typecheck && npm run test:core && npm run test:react && npm run test:architecture && npm run build && npm run test:browser",
    "build:library": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "verify:motion": "npm run typecheck && npm run test:core && npm run test:react && npm run test:architecture && npm run build && npm run test:browser && npm run test:performance",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/library/types/index.d.ts",
      "import": "./dist/library/index.js"
    }
  },
  "files": [
    "dist/library"
  ],
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  }
}
