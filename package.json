{
  "name": "@flute/scene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run tests/core",
    "test:react": "vitest run tests/react",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:browser": "playwright test",
    "verify:surface": "npm run typecheck && npm run test:core && npm run test:react && npm run test:architecture && npm run build && npm run test:browser"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
